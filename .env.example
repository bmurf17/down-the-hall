# App
NEXT_PUBLIC_API_URL=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Database
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hardcover OAuth (confidential client)
# Create an app at https://hardcover.app/account/developer-apps/new
HARDCOVER_CLIENT_ID=
HARDCOVER_CLIENT_SECRET=
# Must exactly match a registered redirect URI:
HARDCOVER_REDIRECT_URI=http://localhost:3000/api/hardcover/callback
# Optional: only this Clerk user may connect the app-wide Hardcover account.
HARDCOVER_OWNER_USER_ID=

# Optional fallback until OAuth is connected, and for scripts in scripts/.
# Sent as: Authorization: Bearer <token>
HARDCOVER_TOKEN=
